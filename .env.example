# Zora: The Integrity Agent - Environment Variables
# Copy this file to .env and fill in your values

# =============================================
# REQUIRED: Google Gemini API Key (100% FREE)
# Get from: https://aistudio.google.com
# Steps: Sign in with Google → "Get API Key" → "Create API key"
# =============================================
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================
# OPTIONAL: SerpAPI (for Google Scholar search)
# Get from: https://serpapi.com/
# If not set, DuckDuckGo (free) is used automatically
# =============================================
SERPAPI_KEY=

# =============================================
# App Settings
# =============================================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
CHROMA_DB_PATH=./zora_chroma_db
PDF_OUTPUT_PATH=./output/receipts
